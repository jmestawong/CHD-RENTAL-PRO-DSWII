                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
